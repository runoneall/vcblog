{
  "name": "vcblog",
  "type": "module",
  "scripts": {
    "dev": "$npx_execpath vite",
    "build": "$npx_execpath vite build",
    "preview": "$npm_execpath run build && $npx_execpath vite preview",
    "deploy": "$npm_execpath run build && $npx_execpath wrangler deploy",
    "check": "$npx_execpath tsc",
    "format": "$npx_execpath prettier --write ."
  },
  "dependencies": {
    "@comark/html": "^0.9.0",
    "@tailwindcss/typography": "^0.5.20",
    "comark-links": "^0.10.1",
    "daisyui": "^5.7.50",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.16",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@tailwindcss/vite": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.110.0"
  }
}
